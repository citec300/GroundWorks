# ==========================================
# Hostinger SMTP & Server Environment Config
# ==========================================

# Puerto de la aplicación (Hostinger lo asigna automáticamente o usa 3000)
PORT=3000

# Parámetros Oficiales Hostinger SMTP
HOSTINGER_SMTP_HOST=smtp.hostinger.com
HOSTINGER_SMTP_PORT=465
HOSTINGER_SMTP_SECURE=true

# Credenciales de la cuenta de correo creada en hPanel
HOSTINGER_SMTP_USER=info@groundworkscorp.com
HOSTINGER_SMTP_PASS=TuContrasenaDeCorreoAqui

# Correo donde el equipo de GroundWorks recibirá las solicitudes de cotización
CONTACT_RECIPIENT_EMAIL=info@groundworkscorp.com
